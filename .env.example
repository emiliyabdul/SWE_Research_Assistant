# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for synthesis) ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Web search provider ---
WEB_SEARCH_PROVIDER=duckduckgo    # tavily | serper | duckduckgo
TAVILY_API_KEY=               # https://tavily.com — free 1000 req/month
# SERPER_API_KEY=             # https://serper.dev — free 2500 req
# (DuckDuckGo needs no key but the duckduckgo-search package must be installed.)

# --- SE-layer settings ---
LOG_LEVEL=INFO
CACHE_BACKEND=sqlite          # sqlite | memory
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
PER_SOURCE_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096           # completion budget; thinking models use part of it internally
MAX_CONCURRENT_REQUESTS=3     # semaphore bound for parallel fetches
MAX_SOURCES_PER_QUERY=3
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=0.5
RETRY_BACKOFF_MAX_SECONDS=8
MAX_QUESTION_LENGTH=500
